# Copie para .env e ajuste se for usar outro projeto Firebase.
# (Os valores abaixo já são os do projeto atual — a chave web do Firebase é pública por natureza;
#  quem protege os dados são as regras do Firestore/Storage + Firebase Auth.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Domínio fictício usado para transformar "usuario" em e-mail do Firebase Auth
VITE_AUTH_DOMAIN_SUFFIX=
